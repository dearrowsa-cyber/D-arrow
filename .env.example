# =============================================================================
#  D-Arrow  ·  Environment Variables Template
# =============================================================================
# COPY THIS FILE TO .env (never commit .env) and fill in the values:
#
#   cp .env.example .env
#
# REQUIRED means the variable MUST be set before `docker compose up -d`
# (or before deploying the Portainer Stack via UI Advanced env vars).
#
# SECURITY — DO NOT COMMIT YOUR FILLED .env TO GIT.
# The values below are PLACEHOLDERS.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Site identity / URLs  [ REQUIRED ]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# 2. Admin & Auth secrets  [ REQUIRED ]
# -----------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32   (run twice for two different values)
ADMIN_PASSWORD=replace_with_very_strong_admin_password
JWT_SECRET=replace_with_64_char_random_string_minimum_please_use_openssl_rand
CRON_SECRET=replace_with_random_string_used_to_secure_background_cron_jobs
BLOG_API_SECRET_KEY=replace_with_random_string_for_blog_content_api

# -----------------------------------------------------------------------------
# 3. PostgreSQL (Prisma datasource)  [ REQUIRED for admin/blog/seo/store DB ]
# -----------------------------------------------------------------------------
POSTGRES_USER=darrow
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DATABASE=darrow

# -----------------------------------------------------------------------------
# 4. Feature toggles
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHATBOT_ENABLED=true

# -----------------------------------------------------------------------------
# 5. SMTP / Email — used by Contact form, store notifications, blog alerts
# -----------------------------------------------------------------------------
CONTACT_RECIPIENT=your-business-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
# !!! Use a dedicated app password, NOT your account password.
#     Gmail  → https://myaccount.google.com/apppasswords
#     Others → check your provider.
SMTP_PASS=your_smtp_app_password__NOT_your_account_password
SMTP_FROM="D-Arrow <noreply@your-domain.com>"
SMTP_SECURE=false
SMTP_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# 6. LLM providers (all OPTIONAL — only set the ones you use)
# -----------------------------------------------------------------------------
ZAI_API_KEY=
ZAI_API_BASE=
ZAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama (optional) — hostname of an ollama container reachable from the app.
# If you don't run Ollama, leave as-is and the chatbot will skip it.
OLLAMA_BASE_URL=http://ollama:11434

# -----------------------------------------------------------------------------
# 7. Integrations (OPTIONAL)
# -----------------------------------------------------------------------------
# N8N webhook URL used by the live chatbot workflow.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Stripe (store checkout — OPTIONAL unless you process real payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 8. Legacy / alias variables (some pages read these)
# -----------------------------------------------------------------------------
# Leave blank if you already set the required variables above; they are
# populated automatically inside docker-compose.yml from the required vars.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
NEON_PROJECT_ID=
