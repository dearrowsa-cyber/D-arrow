                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"name\": \"Premium SEO Package\",\n    \"nameAr\": \"باقة السيو الاحترافية\",\n    \"description\": \"Full SEO optimization for 90 days\",\n    \"descriptionAr\": \"تحسين شامل لمحركات البحث لمدة 90 يوم\",\n    \"price\": 3500,\n    \"salePrice\": 2999,\n    \"currency\": \"SAR\",\n    \"images\": [\"https://www.d-arrow.com/uploads/example.jpg\"],\n    \"category\": \"SEO\",\n    \"categoryAr\": \"سيو\",\n    \"type\": \"digital\",\n    \"downloadUrl\": \"https://www.d-arrow.com/uploads/guide.pdf\",\n    \"demoUrl\": null,\n    \"features\": [\"Keyword research\", \"On-page audit\"],\n    \"featuresAr\": [\"بحث الكلمات المفتاحية\", \"تدقيق داخلي\"],\n    \"status\": \"published\",\n    \"featured\": true\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/store/products",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "store", "products"]
                },
                "description": "Admin. Required: name or nameAr, and price. Slug is auto-generated from name if omitted."
              },
              "response": []
            },
            {
              "name": "Update Product",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"name\": \"Premium SEO Package\",\n    \"price\": 3200,\n    \"salePrice\": 2799,\n    \"featured\": true,\n    \"status\": \"published\"\n}"
