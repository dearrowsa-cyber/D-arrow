                  "raw": "{{baseUrl}}/api/store/products?status=published&featured=true",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "store", "products"],
                  "query": [
                    {
                      "key": "status",
                      "value": "published",
                      "description": "Optional filter: published | draft | archived"
                    },
                    {
                      "key": "category",
                      "value": "",
                      "description": "Optional filter by category slug/name",
                      "disabled": true
                    },
                    {
                      "key": "featured",
                      "value": "true",
                      "description": "Optional filter: true returns featured only"
                    }
                  ]
                },
                "description": "Public. Returns all products with approved reviews and order counts.\nResponse: { \"success\": true, \"products\": [...], \"count\": n }"
              },
              "response": []
            },
            {
              "name": "Get Product by ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/store/products/:id",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "store", "products", ":id"],
                  "variable": [
                    {
                      "key": "id",
                      "value": "REPLACE_WITH_PRODUCT_ID",
                      "description": "Product UUID"
                    }
                  ]
                },
                "description": "Public. Single product with approved reviews.\nResponse: { \"success\": true, \"product\": {...} }"
              },
              "response": []
            },
